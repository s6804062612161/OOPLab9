import java.util.ArrayList;
import java.util.Scanner;

public class ParticleCollision {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;

        int n = sc.nextInt();
        ArrayList<Long> particles = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            particles.add(sc.nextLong());
        }

        long totalEnergy = 0;

        while (particles.size() > 1) {
            long maxDiff = -1;
            int bestIdx = -1;

            for (int i = 0; i < particles.size() - 1; i++) {
                long diff = Math.abs(particles.get(i) - particles.get(i + 1));
                if (diff > maxDiff) {
                    maxDiff = diff;
                    bestIdx = i;
                }
            }

            totalEnergy += maxDiff;
            particles.remove(bestIdx + 1);
            particles.remove(bestIdx);
        }

        System.out.println(totalEnergy);
    }
}
