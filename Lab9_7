import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class AccountGUI extends JFrame {
    private JTextField jtfId = new JTextField(8);
    private JTextField jtfMoney = new JTextField(8);
    private JTextField jtfRate = new JTextField(8);
    private JComboBox<String> cbDayOpen = new JComboBox<>(getDays());
    private JComboBox<String> cbMonthOpen = new JComboBox<>(getMonths());
    private JComboBox<String> cbYearOpen = new JComboBox<>(getYears());
    private JTextField jtfFirstName = new JTextField(12);
    private JTextField jtfLastName = new JTextField(12);
    private JComboBox<String> cbBirthDay = new JComboBox<>(getDays());
    private JComboBox<String> cbBirthMonth = new JComboBox<>(getMonths());
    private JComboBox<String> cbBirthYear = new JComboBox<>(getYears());
    private JTextField jtfAge = new JTextField(4);

    private JButton jbtSave = new JButton("SAVE");
    private JButton jbtShow = new JButton("SHOW");

    private String savedData = "";

    public AccountGUI() {
        JPanel p = new JPanel(new GridLayout(9, 2, 5, 5));
        p.setBorder(BorderFactory.createTitledBorder("Enter Data Account Money"));

        p.add(new JLabel("ID :"));
        p.add(jtfId);
        p.add(new JLabel("MONEY :"));
        p.add(jtfMoney);
        p.add(new JLabel("ANNUAL INTEREST RATE :"));
        p.add(jtfRate);

        JPanel pDayOpen = new JPanel();
        pDayOpen.add(cbDayOpen);
        pDayOpen.add(cbMonthOpen);
        pDayOpen.add(cbYearOpen);
        p.add(new JLabel("DAY OPEN ACCOUNT :"));
        p.add(pDayOpen);

        p.add(new JLabel("FIRST NAME :"));
        p.add(jtfFirstName);
        p.add(new JLabel("LAST NAME :"));
        p.add(jtfLastName);

        JPanel pBirth = new JPanel();
        pBirth.add(cbBirthDay);
        pBirth.add(cbBirthMonth);
        pBirth.add(cbBirthYear);
        p.add(new JLabel("BIRTH DAY :"));
        p.add(pBirth);

        p.add(new JLabel("AGE :"));
        p.add(jtfAge);

        JPanel pButton = new JPanel(new FlowLayout(FlowLayout.RIGHT));
        pButton.add(jbtSave);
        pButton.add(jbtShow);

        add(p, BorderLayout.CENTER);
        add(pButton, BorderLayout.SOUTH);

        jbtSave.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                savedData = "ID: " + jtfId.getText() + "\n" +
                            "Money: " + jtfMoney.getText() + "\n" +
                            "Interest Rate: " + jtfRate.getText() + "\n" +
                            "Date Open: " + cbDayOpen.getSelectedItem() + " " + cbMonthOpen.getSelectedItem() + " " + cbYearOpen.getSelectedItem() + "\n" +
                            "Name: " + jtfFirstName.getText() + " " + jtfLastName.getText() + "\n" +
                            "Birth Date: " + cbBirthDay.getSelectedItem() + " " + cbBirthMonth.getSelectedItem() + " " + cbBirthYear.getSelectedItem() + "\n" +
                            "Age: " + jtfAge.getText();
                JOptionPane.showMessageDialog(null, "Data Saved Successfully!");
            }
        });

        jbtShow.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                if (savedData.isEmpty()) {
                    JOptionPane.showMessageDialog(null, "No Data Saved Yet!");
                } else {
                    JOptionPane.showMessageDialog(null, savedData, "Account Detail", JOptionPane.INFORMATION_MESSAGE);
                }
            }
        });
    }

    private static String[] getDays() {
        String[] days = new String[1];
        for (int i = 0; i < 31; i++) days[i] = String.valueOf(i + 1);
        return days;
    }

    private static String[] getMonths() {
        return new String[]{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
    }

    private static String[] getYears() {
        String[] years = new String[2];
        for (int i = 0; i < 50; i++) years[i] = String.valueOf(1980 + i);
        return years;
    }

    public static void main(String[] args) {
        AccountGUI frame = new AccountGUI();
        frame.setTitle("Show Detail of Account");
        frame.pack();
        frame.setLocationRelativeTo(null);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setVisible(true);
    }
}
